    {
      "tytul": "Plan wydarzeń / Streszczenie (omawiane utwory)",
      "bloki": [
        {
          "typ": "punkt",
          "nr": 1,
          "etykieta": "„Karuzela z madonnami”",
          "tekst": "Wiersz naśladuje ruch kręcącej się karuzeli na jarmarku: koniki i drewniane figurki (madonny) wirują, a rytm, powtórzenia i rozbite słowa oddają ich ruch i barwność. Jarmark, kicz i świętość mieszają się w zachwycie nad codziennym widowiskiem."
        },
        {
          "typ": "punkt",
          "nr": 2,
          "etykieta": "„Szare eminencje zachwytu”",
          "tekst": "Podmiot zachwyca się zwykłymi, szarymi przedmiotami codziennego użytku – piecem, garnkiem, kuchnią, ścianą. To one są „eminencjami”, które ukrycie wywołują zachwyt; poeta odkrywa poezję w tym, co pomijane."
        },
        {
          "typ": "punkt",
          "nr": 3,
          "etykieta": "„Ballada od zejścia do sklepu”",
          "tekst": "Zwykłe wyjście z domu do sklepu opisane jak wielka wyprawa w stylu ballady i eposu: schodzenie po schodach, ulica, zakupy, powrót. Ironiczne wywyższenie banału pokazuje, że codzienność może być przygodą."
        },
        {
          "typ": "punkt",
          "nr": 4,
          "etykieta": "„Moja niewyczerpana oda do radości”",
          "tekst": "Podmiot, który nie ma wiele, odnajduje radość w samym istnieniu i w tym, co ma pod ręką – oda do radości z ubogiej codzienności."
        }
      ]
