        {
          "typ": "punkt",
          "nr": 1,
          "etykieta": "„Miłość”",
          "tekst": "Kobieta mówi, że nie widziała ukochanego od miesiąca i pozornie nic się nie stało: jest tylko trochę bledsza, bardziej śpiąca i milcząca. Puenta zaskakuje: okazuje się, że można żyć bez powietrza – miłość była dla niej jak oddech."
        },
        {
          "typ": "punkt",
          "nr": 2,
          "etykieta": "„Fotografia”",
          "tekst": "Gdy miało się szczęście, które się nie powtarza – czyjeś ciało i cały świat – a zostaje po nim tylko zdjęcie, to jest bardzo mało. Miniatura o przemijaniu miłości."
        },
        {
          "typ": "punkt",
          "nr": 3,
          "etykieta": "„Nike”",
          "tekst": "Miłość porównana do posągu Nike z Samotraki: choć zabita, wciąż biegnie z zapałem, wyciągając odcięte ramiona – trwa mimo zranienia."
        },
