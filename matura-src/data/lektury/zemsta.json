    {
      "tytul": "Informacje podstawowe",
      "bloki": [
        {
          "typ": "punkt",
          "etykieta": "Autor",
          "tekst": "Aleksander Fredro (1793–1876), największy polski komediopisarz."
        },
        {
          "typ": "punkt",
          "etykieta": "Epoka",
          "tekst": "romantyzm (chronologicznie); sam utwór to komedia obyczajowa i charakterów, daleka od romantycznej poetyki."
        },
        {
          "typ": "punkt",
          "etykieta": "Data powstania",
          "tekst": "1833 r.; prapremiera 1834 r. we Lwowie; druk 1838 r."
        },
        {
          "typ": "punkt",
          "etykieta": "Rodzaj i gatunek",
          "tekst": "dramat; komedia charakterów i intrygi w czterech aktach, wierszem (ośmiozgłoskowiec)."
        },
        {
          "typ": "punkt",
          "etykieta": "Czas i miejsce akcji",
          "tekst": "przełom XVIII i XIX w.; zamek w Odrzykoniu podzielony murem na dwie części – Cześnika i Rejenta."
        },
        {
          "typ": "punkt",
          "etykieta": "Geneza",
          "tekst": "Fredro oparł fabułę na dokumentach o prawdziwym sporze o zamek Kamieniec w Odrzykoniu, które znalazł w posagu żony."
        }
      ]
    },
    {
      "tytul": "Szczegółowe streszczenie",
      "bloki": [
        {
          "typ": "punkt",
          "etykieta": "Spór o mur",
          "tekst": "Cześnik Maciej Raptusiewicz i Rejent Milczek mieszkają w jednym zamku i od lat są skłóceni. Kością niezgody jest mur graniczny, który Rejent chce naprawić, a Cześnik – zburzyć."
        },
        {
          "typ": "punkt",
          "etykieta": "Swaty",
          "tekst": "stary Cześnik chce się ożenić z bogatą wdową, Podstoliną Hanną, i wysyła z oświadczynami tchórzliwego Papkina. Jego bratanica (synowica) Klara potajemnie kocha Wacława, syna Rejenta."
        },
        {
          "typ": "punkt",
          "etykieta": "Papkin u Rejenta",
          "tekst": "Cześnik wysyła Papkina, by przegonił murarzy Rejenta, a potem z wyzwaniem na pojedynek. Wacław potajemnie spotyka się z Klarą w zamku Cześnika."
        },
        {
          "typ": "punkt",
          "etykieta": "Intrygi",
          "tekst": "Rejent chce ożenić syna z bogatą Podstoliną, która okazuje się dawną znajomą Wacława, i Podstolina zrywa z Cześnikiem. Wściekły Cześnik szuka zemsty. Gdy Wacław wpada w jego ręce, Cześnik – by pokrzyżować plany Rejenta – każe mu natychmiast poślubić Klarę. Ślub odbywa się w zamku Cześnika."
        },
        {
          "typ": "punkt",
          "etykieta": "Papkin i „trucizna”",
          "tekst": "Papkin, przekonany, że wypił zatrute wino, dyktuje komiczny testament."
        },
        {
          "typ": "punkt",
          "etykieta": "Rozwiązanie",
          "tekst": "Rejent przybywa, gdy jest już po ślubie. Obaj sąsiedzi się godzą. Komedia kończy się słowami: „Zgoda! zgoda! – A Bóg wtedy rękę poda”."
        },
        {
          "typ": "akapit",
          "tekst": "**Znaczenie:** zemsta, w której Cześnik chce zaszkodzić Rejentowi, obraca się w szczęśliwe zakończenie – zakochani się pobierają, a spór się kończy."
        }
      ]
    },
