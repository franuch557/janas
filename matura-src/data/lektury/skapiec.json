      "bloki": [
        {
          "typ": "akapit",
          "tekst": "*Uwaga: przed użyciem sprawdź przebieg scen w wydaniu źródłowym; poniżej główna linia fabuły.*"
        },
        {
          "typ": "punkt",
          "etykieta": "Początek",
          "tekst": "Harpagon, bogaty i skąpy ojciec, ukrywa w ogrodzie szkatułkę z pieniędzmi. Jego dzieci, Kleant i Elżbieta, mają swoje miłości, których on nie akceptuje."
